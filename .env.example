# SerpApi (genuine Google Lens reverse-image search) — free tier,
# 250 searches/month, no credit card required. Sign up at serpapi.com.
SERPAPI_KEY=your_serpapi_key

# Polygon Amoy testnet (blockchain write)
RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
PRIVATE_KEY=0xyour_test_wallet_private_key_never_commit_this
CONTRACT_ADDRESS=0xyour_deployed_FaceRecord_contract_address

# Optional: IPFS pinning of the full payload via Pinata (free tier).
# If left unset, the pipeline still works — it just stores the hash
# on-chain without also archiving the full payload on IPFS.
PINATA_JWT=your_pinata_jwt_token
